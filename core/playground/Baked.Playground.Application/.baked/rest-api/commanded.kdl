clear-commanded @controller-model {
  execute {
    @action-model route="DELETE /commanded" required-claims="BaseA, BaseB"
    execute-param {
      @parameter-model in="query"
    }
  }
}

commanded @controller-model {
  method {
    @action-model route="POST /commanded/method" required-claims="BaseA, BaseB"
    body {
      @parameter-model required=#true
    }
  }
}

execute-commanded @controller-model {
  execute {
    @action-model route="POST /commanded" required-claims="BaseA, BaseB"
  }
}

get-commanded @controller-model {
  execute {
    @action-model route="GET /commanded" required-claims="BaseA, BaseB"
  }
}

update-commanded @controller-model {
  execute {
    @action-model route="PATCH /commanded" required-claims="BaseA, BaseB"
  }
}

