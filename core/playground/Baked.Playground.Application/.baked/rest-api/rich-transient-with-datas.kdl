rich-transient-with-data @api-controller {
  with {
    @api-action route="GET /rich-transient-with-datas/{id}" required-claims="BaseA, BaseB"
    id {
      @api-parameter required=#true in="route"
    }
  }
  method {
    @api-action route="POST /rich-transient-with-datas/{id}/method" required-claims="BaseA, BaseB"
    text {
      @api-parameter required=#true
    }
  }
}

rich-transient-extension @api-controller {
  from-extension {
    @api-action route="POST /rich-transient-with-datas/{id}/from-extension" required-claims="BaseA, BaseB"
  }
}

