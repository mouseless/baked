entity @entity {
  id @column {
    @id type="guid" generator="id-guid"
  }
  guid @column
  string @column
  string-data @column
  int32 @column
  decimal @column
  double @column
  boolean @column
  unique @column @unique
  uri @column
  mail-address @column
  dynamic @column
  enum @column @unique
  flags-enum @column
  date-time @column
  date-only @column
  time-only @column
}

